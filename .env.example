# ==============================================================================
# VenomGuard Environment Variables Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# OpenAI API Key (used for conversational first-aid assistant)
# If not provided, VenomGuard gracefully falls back to the offline WHO-compliant guidance engine.
OPENAI_API_KEY=

# Google Maps API Key (used for geocoding and nearby emergency hospital lookup)
# If not provided, VenomGuard falls back to OpenStreetMap / Geopy and regional emergency registries.
GOOGLE_MAPS_API_KEY=

# Roboflow API Key (used for cloud-based snake detection & species identification)
# If not provided, VenomGuard operates in local offline / demo mode.
ROBOFLOW_API_KEY=

# Optional: Set to 'true' to force offline demonstration mode without live API calls
VENOMGUARD_DEMO_MODE=false
